{
    // SP Only
    "ignoreCourseLock": false, // Set it to true to always unlock course. Default false
    // SP / MP
    "compatabilityMode": true, // Helps with packs from pre-2.0.0
    "maxSliderValue": 4.0, // How far can a gun jam/dmg slider go. Default 4.0

    // MP only, Host only
    "strictSync": false, // If false, allows some illegal actions from clients, W.I.P.. Default false
    "gunSyncRate": 1.0, // If you have performence isseuse, try to increase this value. Default 1.0
    "magSyncRate": 1.0, // If you have performence isseuse, try to increase this value. Default 1.0
    "projectileSyncRate": 0.1, // Seconds between host projectile snapshots. Must be finite and greater than zero. Default 0.1
}
